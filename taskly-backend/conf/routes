POST    /api/v1/auth/signup                 com.taskly.backend.users.presentation.AuthController.signUp(request: Request)
POST    /api/v1/auth/signin                 com.taskly.backend.users.presentation.AuthController.signIn(request: Request)
GET     /api/v1/auth/signout                com.taskly.backend.users.presentation.AuthController.signOut

