GET     /api/v1/tasks/:id                   com.taskly.backend.tasks.presentation.TasksController.get(request: Request, id: String)
PATCH   /api/v1/tasks/:id                   com.taskly.backend.tasks.presentation.TasksController.update(request: Request, id: String)
DELETE  /api/v1/tasks/:id                   com.taskly.backend.tasks.presentation.TasksController.delete(request: Request, id: String)

