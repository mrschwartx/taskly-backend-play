<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <variable name="TASKLY_LOG_LEVEL" value="${LOG_LEVEL:-info}"/>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{36} - %message%n%xException{10}</pattern>
    </encoder>
  </appender>

  <logger name="play" level="INFO"/>
  <logger name="org.apache.pekko" level="INFO"/>
  <logger name="com.taskly" level="${TASKLY_LOG_LEVEL}"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>

</configuration>
